// Cloudflare 배포 설정 — 앱 파일만 모은 dist/ 폴더를 정적 사이트로 올린다 (README "개발" 참고)
{
  "name": "hp-trainer",
  "compatibility_date": "2025-06-01",
  // 배포 전에 dist/를 만든다 (tools/build.js: index.html·css·js·diagrams만 복사)
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist" },
  // dev 등 main이 아닌 브랜치의 미리보기(npx wrangler preview)에 필요. 비어 있어도 됨
  "previews": {}
}
